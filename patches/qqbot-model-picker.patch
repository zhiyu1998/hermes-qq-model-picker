+    # ── /model picker (cross-adapter contract: gateway calls send_model_picker) ──
+
+    _MODEL_PICKER_PAGE_SIZE = 8
+
+    def _model_picker_store(self) -> dict:
+        """Pending pickers keyed by session_key (one live picker per chat)."""
+        store = getattr(self, "_model_picker_pending", None)
+        if not isinstance(store, dict):
+            store = {}
+            self._model_picker_pending = store
+        return store
+
+    _MODEL_BUTTON_LABEL_MAX = 20
+
+    @staticmethod
+    def _provider_label(prov) -> str:
+        """Human-readable provider label ("OpenRouter", "Xiaomi MiMo", "custom")."""
+        name = str(prov.get("name") or "").strip()
+        if name:
+            return name.split("(")[0].strip() or name
+        return str(prov.get("slug") or "").strip() or "?"
+
+    @staticmethod
+    def _model_picker_items(providers, current_provider: str = "", current_model: str = "") -> list:
+        """Flatten picker providers into ``(provider_slug, provider_label, model_id)``.
+
+        The active provider comes first (QQ shows only one keyboard page at a time,
+        so a 58-model catalog must not bury the route in use), then any provider
+        offering the current model, then the rest.
+        """
+        def rank(prov) -> int:
+            slug = str(prov.get("slug") or "")
+            models = [str(m) for m in (prov.get("models") or [])]
+            if current_provider and slug == current_provider:
+                return 0
+            if current_model and current_model in models:
+                return 1
+            return 2
+
+        items: list = []
+        seen: set = set()
+        for prov in sorted(providers or [], key=rank):
+            slug = str(prov.get("slug") or "")
+            label = QQAdapter._provider_label(prov)
+            for raw in (prov.get("models") or []):
+                model_id = str(raw)
+                key = (slug, model_id)
+                if key in seen:
+                    continue
+                seen.add(key)
+                items.append((slug, label, model_id))
+        return items
+
+    async def _send_model_picker_page(self, chat_id: str, key: str, page: int) -> SendResult:
+        state = self._model_picker_store().get(key) or {}
+        items = state.get("items") or []
+        if not items:
+            return SendResult(success=False, error="no models to pick", retryable=False)
+        size = self._MODEL_PICKER_PAGE_SIZE
+        total_pages = max(1, (len(items) + size - 1) // size)
+        page = max(0, min(int(page), total_pages - 1))
+        state["page"] = page
+        current_provider, current_model = state.get("current") or ("", "")
+        start = page * size
+        window = items[start:start + size]
+        current_label = next(
+            (prov_label for slug, prov_label, model in items
+             if (slug, model) == (current_provider, current_model)),
+            current_provider or "?")
+
+        # The legend carries the full provider + model id, because a QQ button label
+        # is too narrow to fit both legibly; the buttons just carry the index.
+        lines = [f"🧠 **选择模型**（第 {page + 1}/{total_pages} 页）", "",
+                 f"当前：{current_label} · `{current_model or '未知'}`", ""]
+        for offset, (slug, prov_label, model_id) in enumerate(window):
+            mark = " ✓" if (slug, model_id) == (current_provider, current_model) else ""
+            lines.append(f"{start + offset + 1}. {prov_label} · `{model_id}`{mark}")
+        lines += ["", "点下面的数字按钮切换："]
+        text = "\n".join(lines)
+
+        keyboard = build_model_picker_keyboard(
+            items, key, current=(current_provider, current_model),
+            page=page, page_size=size)
+        return await self.send_with_keyboard(chat_id, text, keyboard, reply_to=self._last_msg_id.get(chat_id))
+
+    async def send_model_picker(
+        self, chat_id: str, providers: list, current_model: str = "", current_provider: str = "",
+        session_key: str = "", on_model_selected=None, metadata: Optional[dict[str, Any]] = None,
+    ) -> SendResult:
+        """Inline-keyboard /model picker: tap a model button to switch (QQ 5-row keyboard limit)."""
+        del metadata
+        try:
+            items = self._model_picker_items(providers, current_provider, current_model)
+            if not items:
+                return SendResult(success=False, error="no models to pick", retryable=False)
+            key = session_key or chat_id
+            self._model_picker_store()[key] = {
+                "items": items, "on_model_selected": on_model_selected, "chat_id": chat_id,
+                "current": (current_provider, current_model), "page": 0,
+            }
+            return await self._send_model_picker_page(chat_id, key, 0)
+        except Exception as exc:
+            logger.error("[%s] send_model_picker failed: %s", self._log_tag, exc, exc_info=True)
+            return SendResult(success=False, error=str(exc) or type(exc).__name__)
+
+    async def _send_model_picker_notice(self, chat_id: str, text: str) -> None:
+        sender = self._text_sender(self._guess_chat_type(chat_id))
+        if sender is None:
+            return
+        try:
+            await sender(chat_id, text[: self.MAX_MESSAGE_LENGTH], self._last_msg_id.get(chat_id))
+        except Exception as exc:
+            logger.warning("[%s] model picker notice failed: %s", self._log_tag, exc)
+
+    async def _handle_model_pick_interaction(self, event: InteractionEvent, kind: str,
+                                             fields: tuple) -> None:
+        """Dispatch a /model picker button click: select / page / cancel."""
+        session_key = fields[-1]
+        store = self._model_picker_store()
+        state = store.get(session_key)
+        if state is None:
+            logger.info("[%s] Model picker state gone for session %s", self._log_tag, session_key)
+            return
+        if not self._is_authorized_interaction_for_session(event, session_key):
+            logger.warning("[%s] Rejected unauthorized model pick for session %s (operator=%s)",
+                           self._log_tag, session_key, event.operator_openid)
+            return
+        chat_id = state.get("chat_id") or event.user_openid
+        if kind == "x":
+            store.pop(session_key, None)
+            await self._send_model_picker_notice(chat_id, "已取消模型切换。")
+            return
+        if kind == "p":
+            await self._send_model_picker_page(chat_id, session_key, int(fields[0]))
+            return
+        provider, model = fields[0], fields[1]
+        callback = state.get("on_model_selected")
+        store.pop(session_key, None)
+        if callback is None:
+            await self._send_model_picker_notice(chat_id, "选择器已失效，请重新发送 /model。")
+            return
+        try:
+            reply = await callback(chat_id, model, provider)
+        except Exception as exc:
+            logger.error("[%s] Model picker switch failed: %s", self._log_tag, exc, exc_info=True)
+            reply = f"❌ 切换模型失败：{exc}"
+        await self._send_model_picker_notice(chat_id, reply or "✅ 已切换模型。")
+
     def _build_text_body(self, content: str, reply_to: Optional[str] = None) -> dict[str, Any]:
