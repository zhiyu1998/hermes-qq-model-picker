diff --git a/plugins/platforms/qqbot/keyboards.py b/plugins/platforms/qqbot/keyboards.py
index 46ab7a83bc..b3135a7567 100644
--- a/plugins/platforms/qqbot/keyboards.py
+++ b/plugins/platforms/qqbot/keyboards.py
@@ -189,3 +189,78 @@ def parse_interaction_event(raw: dict[str, Any]) -> InteractionEvent:
         channel_id=str(raw.get("channel_id", "")), guild_id=str(raw.get("guild_id", "")),
         button_data=str(resolved.get("button_data", "")), button_id=str(resolved.get("button_id", "")),
         resolver_user_id=str(resolved.get("user_id", "")))
+
+
+# ── /model picker ────────────────────────────────────────────────────────────
+MODEL_PICK_PREFIX = "model_pick:"
+_MODEL_LABEL_MAX = 20  # QQ inline-keyboard button label limit
+_MODEL_PICK_RE = re.compile(r"^model_pick:([mpx])\|(.+)$")
+
+
+def parse_model_pick_button_data(button_data: str) -> Optional[tuple[str, tuple[str, ...]]]:
+    """Parse a /model picker ``button_data`` into ``(kind, fields)``.
+
+    Kinds: ``m`` select → ``("m", (provider, model, session_key))``;
+    ``p`` page → ``("p", (page, session_key))``; ``x`` cancel → ``("x", (session_key,))``.
+    """
+    m = _MODEL_PICK_RE.match(button_data or "")
+    if not m:
+        return None
+    kind, rest = m.group(1), m.group(2)
+    parts = tuple(rest.split("|"))
+    if kind == "m" and len(parts) == 3:
+        return kind, parts
+    if kind == "p" and len(parts) == 2 and parts[0].isdigit():
+        return kind, parts
+    if kind == "x" and len(parts) == 1:
+        return kind, parts
+    return None
+
+
+def _model_pick_button(btn_id: str, label: str, data: str, *, style: int = 1,
+                       visited: str = "已选择") -> KeyboardButton:
+    return KeyboardButton(
+        id=btn_id, group_id="model_pick",
+        action=KeyboardButtonAction(type=1, data=data),
+        render_data=KeyboardButtonRenderData(label=label, visited_label=visited, style=style))
+
+
+def build_model_picker_keyboard(items: list, session_key: str, *, current: tuple = ("", ""),
+                                page: int = 0, page_size: int = 8) -> InlineKeyboard:
+    """Build the /model picker keyboard.
+
+    QQ allows at most 5 rows per keyboard, so a page shows ``page_size`` models at
+    two per row plus one action row (``下一页`` when more remain, always ``取消``).
+    *items* holds ``(provider_slug, provider_label, model_id)`` triples.
+
+    A button label is narrow, so it carries only ``<index>. <short model>`` — the
+    message body renders the full ``provider · model`` legend for those indexes.
+    """
+    start = page * page_size
+    window = items[start:start + page_size]
+    rows: list[KeyboardRow] = []
+    for i in range(0, len(window), 2):
+        buttons = []
+        for offset, (provider, _provider_label, model) in enumerate(window[i:i + 2]):
+            idx = start + i + offset
+            is_current = (provider, model) == (current[0], current[1])
+            number = str(idx + 1)
+            budget = _MODEL_LABEL_MAX - len(number) - 2 - (1 if is_current else 0)  # "12. " (+"✓")
+            short = model.split("/")[-1] if "/" in model else model
+            if len(short) > budget:
+                short = short[:max(budget - 1, 4)] + "…"
+            label = f"{number}. {short}"
+            if is_current:
+                label = "✓" + label
+            data = f"{MODEL_PICK_PREFIX}m|{provider}|{model}|{session_key}"
+            buttons.append(_model_pick_button(f"m{idx}", label[:_MODEL_LABEL_MAX], data))
+        rows.append(KeyboardRow(buttons=buttons))
+    actions = []
+    if start + page_size < len(items):
+        actions.append(_model_pick_button(
+            "next", "下一页 ▸", f"{MODEL_PICK_PREFIX}p|{page + 1}|{session_key}",
+            style=1, visited="下一页"))
+    actions.append(_model_pick_button(
+        "cancel", "取消", f"{MODEL_PICK_PREFIX}x|{session_key}", style=0, visited="已取消"))
+    rows.append(KeyboardRow(buttons=actions))
+    return InlineKeyboard(content=KeyboardContent(rows=rows[:5]))
